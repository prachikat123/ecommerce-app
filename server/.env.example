# Copy to `.env` and adjust for your environment.
# Never commit the real `.env` — it is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change the provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production, and must NOT be the development default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"
# Max sign-in attempts per IP per 10 minutes.
AUTH_RATE_LIMIT=10

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be explicit (not "*") in production.
CORS_ORIGIN="http://localhost:5173"

# ── One-time passcodes (OTP) ────────────────────────────────────────────────
# When true, sign-in accepts DEV_OTP_CODE and returns it in the API response
# instead of sending an SMS. Forced off in production.
OTP_DEV_BYPASS=true
OTP_DEV_CODE=123456
# How long a code stays valid, and how many wrong guesses are allowed.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Outbound SMS provider for one-time passcodes (console = dev-only logs).
SMS_PROVIDER=console
