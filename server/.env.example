# Copy to `.env` and adjust for your environment.
# Never commit the real `.env` — it is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change the provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production, and must NOT be the development default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"
# Max sign-in attempts per IP per 10 minutes.
AUTH_RATE_LIMIT=10

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be explicit (not "*") in production.
CORS_ORIGIN="http://localhost:5173"

# ── One-time passcodes (OTP) ────────────────────────────────────────────────
# When true, sign-in accepts DEV_OTP_CODE and returns it in the API response
# instead of sending a message. Forced off in production.
OTP_DEV_BYPASS=true
OTP_DEV_CODE=123456
# How long a code stays valid, and how many wrong guesses are allowed.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Messaging (one-time passcodes) ──────────────────────────────────────────
# Channel used to deliver passcodes. "console" only logs the code (dev-only);
# "whatsapp" sends through the WhatsApp Business Cloud API (Meta).
MESSAGE_PROVIDER=console
# Country code prepended to a bare 10-digit number when building E.164.
OTP_COUNTRY_CODE="+91"
# WhatsApp Business Cloud API credentials — required when MESSAGE_PROVIDER=whatsapp.
# Find the phone number ID and create a system-user access token in Meta Business
# Manager > WhatsApp > API Setup. The template must be pre-approved by Meta with
# two body variables: {{1}} = code, {{2}} = expiry in minutes.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=krishibazaar_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
