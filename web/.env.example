# Copy to `.env` for local overrides. All variables are optional.

# Base URL for API requests.
#
# Leave this UNSET in development: the Vite dev server proxies "/api" to the
# Express API on http://localhost:4000 (see vite.config.ts).
#
# In production there is no proxy, so this MUST point at your deployed API.
# For example:
# VITE_API_URL=https://krishibazaar-api.onrender.com/api
